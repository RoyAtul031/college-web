/* Reduced Motion Optimization */
@media (prefers-reduced-motion: reduce) {
  .featured-photo-img {
    animation: none !important;
  }

  .filmroll-sliding-track {
    animation: none !important;
    overflow-x: auto;
  }

  .frame-photo-asset,
  .teaser-bg {
    transition: none !important;
  }
}
</style>

<!-- Ultra-Lightweight Vanilla JS Controller (< 2 KB) for Morphing & Dialog -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Data & DOM Elements
    const dataTag = document.getElementById('gallery-categories-data');
    if (!dataTag) return;
    const categories = JSON.parse(dataTag.textContent);

    const navTabs = document.querySelectorAll('.cat-nav-tab');
    const morphStage = document.getElementById('gallery-morph-stage');

    // Featured Hero Elements
    const heroCatName = document.getElementById('featured-cat-name');
    const heroCounter = document.getElementById('featured-counter');
    const heroFrame = document.getElementById('featured-photo-frame');
    const heroImg = document.getElementById('featured-photo-img');
    const heroYear = document.getElementById('featured-year-tag');
    const heroTitle = document.getElementById('featured-title');
    const heroDesc = document.getElementById('featured-desc');

    // Editorial Frames Grid Elements
    const seriesTitle = document.getElementById('frames-series-title');
    const framesGrid = document.getElementById('editorial-frames-grid');

    // Native Dialog Elements
    const dialog = document.getElementById('photo-dialog');
    const dialogImg = document.getElementById('dialog-img-el');
    const dialogTitle = document.getElementById('dialog-title');
    const dialogCaption = document.getElementById('dialog-caption');
    const dialogCat = document.getElementById('dialog-cat');
    const dialogCounter = document.getElementById('dialog-counter');
    const closeBtn = document.getElementById('dialog-close-btn');
    const prevBtn = document.getElementById('dialog-prev-btn');
    const nextBtn = document.getElementById('dialog-next-btn');

    let currentCategoryKey = 'raceDay';
    let currentPhotoIdx = 0;
    let activeCategoryPhotos = categories.raceDay.images;

    // 2. Morph Switch Category
    function morphToCategory(catKey) {
      const catData = categories[catKey];
      if (!catData) return;

      if (catData.isSpecialTeaser) {
        const teaserSection = document.getElementById('cat-coming-soon');
        if (teaserSection) {
          teaserSection.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
        return;
      }

      currentCategoryKey = catKey;
      activeCategoryPhotos = catData.images;

      // Update Active Navigation Tab
      navTabs.forEach(tab => {
        const isCurrent = tab.getAttribute('data-cat-key') === catKey;
        tab.classList.toggle('active', isCurrent);
        tab.setAttribute('aria-selected', isCurrent ? 'true' : 'false');
        if (isCurrent) {
          tab.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        }
      });

      // Trigger Morph Animation (cross-fade + subtle scale + blur)
      morphStage.classList.add('is-morphing');

      setTimeout(() => {
        // Update Featured Lead Card
        if (heroCatName) heroCatName.textContent = catData.subtitle;
        if (heroCounter) heroCounter.textContent = catData.counter;
        if (heroYear) heroYear.textContent = catData.year;
        if (heroTitle) heroTitle.textContent = catData.featuredCaption.title;
        if (heroDesc) heroDesc.textContent = catData.featuredCaption.desc;

        if (heroImg) {
          heroImg.src = catData.images[0].src;
          heroImg.alt = catData.images[0].alt;
        }

        if (heroFrame) {
          heroFrame.setAttribute('data-img', catData.images[0].src);
          heroFrame.setAttribute('data-title', catData.featuredCaption.title);
          heroFrame.setAttribute('data-caption', catData.featuredCaption.desc);
          heroFrame.setAttribute('data-cat', catData.subtitle);
          heroFrame.setAttribute('data-num', '01 / 07');
        }

        // Update Frames Series Title
        if (seriesTitle) {
          seriesTitle.textContent = `7 Curated Moments from ${catData.subtitle}`;
        }

        // Update Grid Layout Variant
        framesGrid.className = `editorial-frames-grid ${catData.gridVariant}`;

        // Rebuild 7 Asymmetric Editorial Frames
        framesGrid.innerHTML = catData.images.map((photo, idx) => `
          <figure 
            class="diverse-frame-item frame-slot-${idx + 1}"
            data-img="${photo.src}"
            data-title="${photo.title}"
            data-caption="${photo.caption}"
            data-cat="${catData.subtitle}"
            data-num="0${idx + 1} / 07"
            data-idx="${idx}"
            tabindex="0"
            role="button"
            aria-label="View moment 0${idx + 1}: ${photo.title}"
          >
            <div class="frame-media-shell">
              <img 
                src="${photo.src}" 
                alt="${photo.alt}"
                class="frame-photo-asset"
                loading="lazy"
              />
              <div class="frame-hover-layer">
                <div class="hover-bubble">
                  <span class="plus-sign">+</span>
                  <span class="hover-inspect-txt">VIEW MOMENT</span>
                </div>
                <div class="hover-meta-footer">
                  <span class="hover-tag">${photo.tag}</span>
                  <span class="hover-title">${photo.title}</span>
                </div>
              </div>
            </div>
            <figcaption class="frame-caption-bar">
              <span class="frame-number-badge">0${idx + 1}</span>
              <div class="frame-text-group">
                <h5 class="frame-title-text">${photo.title}</h5>
                <p class="frame-desc-text">${photo.caption}</p>
              </div>
            </figcaption>
          </figure>
        `).join('');

        // Rebind click listeners on newly rendered frames
        bindFrameListeners();

        // Release morph animation
        morphStage.classList.remove('is-morphing');
      }, 250);
    }

    // 3. Tab Clicks
    navTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const catKey = tab.getAttribute('data-cat-key');
        if (catKey) morphToCategory(catKey);
      });
    });

    // 4. Lightbox Controller using Native <dialog>
    function openPhotoModal(idx) {
      if (!activeCategoryPhotos || activeCategoryPhotos.length === 0) return;
      if (idx < 0) idx = activeCategoryPhotos.length - 1;
      if (idx >= activeCategoryPhotos.length) idx = 0;
      currentPhotoIdx = idx;

      const photo = activeCategoryPhotos[currentPhotoIdx];
      const catData = categories[currentCategoryKey] || categories.raceDay;

      if (dialogImg) {
        dialogImg.src = photo.src;
        dialogImg.alt = photo.title;
      }
      if (dialogTitle) dialogTitle.textContent = photo.title;
      if (dialogCaption) dialogCaption.textContent = photo.caption;
      if (dialogCat) dialogCat.textContent = catData.subtitle;
      if (dialogCounter) dialogCounter.textContent = `0${currentPhotoIdx + 1} / 0${activeCategoryPhotos.length}`;

      if (dialog) {
        if (typeof dialog.showModal === 'function') {
          dialog.showModal();
        } else {
          dialog.setAttribute('open', '');
        }
      }
      document.body.style.overflow = 'hidden';
    }

    function closePhotoModal() {
      if (dialog) {
        dialog.close();
      }
      document.body.style.overflow = '';
      if (dialogImg) dialogImg.src = '';
    }

    if (closeBtn) closeBtn.addEventListener('click', closePhotoModal);
    if (prevBtn) prevBtn.addEventListener('click', () => openPhotoModal(currentPhotoIdx - 1));
    if (nextBtn) nextBtn.addEventListener('click', () => openPhotoModal(currentPhotoIdx + 1));

    window.addEventListener('keydown', (e) => {
      if (!dialog || !dialog.open) return;
      if (e.key === 'ArrowLeft') openPhotoModal(currentPhotoIdx - 1);
      if (e.key === 'ArrowRight') openPhotoModal(currentPhotoIdx + 1);
    });

    dialog?.addEventListener('click', (e) => {
      if (e.target === dialog) closePhotoModal();
    });

    // 5. Bind Click Listeners to Frames
    function bindFrameListeners() {
      const frames = framesGrid.querySelectorAll('.diverse-frame-item');
      frames.forEach(frame => {
        const handler = () => {
          const idx = parseInt(frame.getAttribute('data-idx') || '0', 10);
          openPhotoModal(idx);
        };
        frame.addEventListener('click', handler);
        frame.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            handler();
          }
        });
      });
    }

    // Bind featured hero click
    if (heroFrame) {
      const heroHandler = () => openPhotoModal(0);
      heroFrame.addEventListener('click', heroHandler);
      heroFrame.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          heroHandler();
        }
      });
    }

    // Bind Filmroll Cards Click
    const filmCards = document.querySelectorAll('.film-frame-card');
    filmCards.forEach(card => {
      card.addEventListener('click', () => {
        const src = card.getAttribute('data-img');
        const title = card.getAttribute('data-title');
        const cat = card.getAttribute('data-cat');
        const caption = card.getAttribute('data-caption');
        const num = card.getAttribute('data-num');

        if (dialogImg) {
          dialogImg.src = src;
          dialogImg.alt = title;
        }
        if (dialogTitle) dialogTitle.textContent = title;
        if (dialogCaption) dialogCaption.textContent = caption;
        if (dialogCat) dialogCat.textContent = cat;
        if (dialogCounter) dialogCounter.textContent = num;

        if (dialog) dialog.showModal();
        document.body.style.overflow = 'hidden';
      });
    });

    // Initial listener binding
    bindFrameListeners();
  });
</script>
