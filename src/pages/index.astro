  <!-- Ultra-Lightweight Vanilla JS: Navigation, Tabs, Countdown, Lightbox (No Framework Overhead) -->
  <script is:inline>
    // 1. Mobile Menu Toggle
    const menuToggle = document.getElementById('menu-toggle');
    const navLinks = document.getElementById('nav-links');
    if (menuToggle && navLinks) {
      menuToggle.addEventListener('click', () => {
        const isOpen = navLinks.classList.toggle('open');
        menuToggle.classList.toggle('active', isOpen);
        menuToggle.setAttribute('aria-expanded', isOpen);
      });
      navLinks.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => {
          navLinks.classList.remove('open');
          menuToggle.classList.remove('active');
          menuToggle.setAttribute('aria-expanded', 'false');
        });
      });
    }

    // 2. Header Scroll Shadow
    const header = document.getElementById('header');
    window.addEventListener('scroll', () => {
      if (header) {
        header.classList.toggle('scrolled', window.scrollY > 40);
      }
    }, { passive: true });

    // 3. Countdown Timer (Target: Jan 10, 2027 05:00:00 - Stg Athlenic Verified)
    const targetDate = new Date('2027-01-10T05:00:00');
    function updateCountdown() {
      const now = new Date();
      const diff = targetDate - now;
      if (diff <= 0) return;
      const days = Math.floor(diff / (1000 * 60 * 60 * 24));
      const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const mins = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      const secs = Math.floor((diff % (1000 * 60)) / 1000);
      const dEl = document.getElementById('days');
      const hEl = document.getElementById('hours');
      const mEl = document.getElementById('minutes');
      const sEl = document.getElementById('seconds');
      if (dEl) dEl.textContent = String(days).padStart(2, '0');
      if (hEl) hEl.textContent = String(hours).padStart(2, '0');
      if (mEl) mEl.textContent = String(mins).padStart(2, '0');
      if (sEl) sEl.textContent = String(secs).padStart(2, '0');
    }
    updateCountdown();
    setInterval(updateCountdown, 1000);

    // 4. Smooth Scroll Navigation with Precise Header Offset
    document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
      anchor.addEventListener('click', function (e) {
        const targetId = this.getAttribute('href');
        if (!targetId || targetId === '#') return;
        const targetElement = document.querySelector(targetId);
        if (targetElement) {
          e.preventDefault();
          const headerHeight = 72;
          const elementPos = targetElement.getBoundingClientRect().top + window.pageYOffset;
          window.scrollTo({
            top: Math.max(0, elementPos - headerHeight),
            behavior: 'smooth'
          });
          // Update URL hash without jumping
          history.pushState(null, '', targetId);
        }
      });
    });

    // 7. Subtle Reveal-on-Scroll Observer
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('in-view');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });

      document.querySelectorAll('.stat-card, .race-card, .gallery-card, .detail-box, .letter-card, .about-grid, .message-layout, .charity-card, .charity-action-banner').forEach(el => {
        el.classList.add('scroll-reveal');
        observer.observe(el);
      });
    }

    // 8. FAQ Accordion Interactive Expansion
    const faqItems = document.querySelectorAll('.faq-item');
    faqItems.forEach(item => {
      const questionBtn = item.querySelector('.faq-question');
      const answer = item.querySelector('.faq-answer');
      if (!questionBtn || !answer) return;

      // Set initial state
      if (item.classList.contains('active')) {
        answer.style.maxHeight = answer.scrollHeight + 'px';
      }

      questionBtn.addEventListener('click', () => {
        const isOpen = item.classList.contains('active');

        // Close other accordion items for clean single-view experience
        faqItems.forEach(otherItem => {
          if (otherItem !== item && otherItem.classList.contains('active')) {
            otherItem.classList.remove('active');
            const otherBtn = otherItem.querySelector('.faq-question');
            const otherAns = otherItem.querySelector('.faq-answer');
            if (otherBtn) otherBtn.setAttribute('aria-expanded', 'false');
            if (otherAns) otherAns.style.maxHeight = null;
          }
        });

        if (isOpen) {
          item.classList.remove('active');
          questionBtn.setAttribute('aria-expanded', 'false');
          answer.style.maxHeight = null;
        } else {
          item.classList.add('active');
          questionBtn.setAttribute('aria-expanded', 'true');
          answer.style.maxHeight = answer.scrollHeight + 20 + 'px';
        }
      });
    });

    // 9. Running Athletes Ground Photo — Scroll-Synchronized Parallax & Dynamic Blur Texture
    const bgAthletesInner = document.getElementById('bg-athletes-inner');
    const bgAthletesImg = document.getElementById('bg-athletes-img');

    let lastScrollY = window.pageYOffset || 0;
    let ticking = false;

    function updateBgAthletesOnScroll() {
      const scrollY = window.pageYOffset || document.documentElement.scrollTop;
      const maxScroll = Math.max(document.documentElement.scrollHeight - window.innerHeight, 1);
      const progress = Math.min(Math.max(scrollY / maxScroll, 0), 1);

      // Scroll velocity for dynamic motion-blur texture response
      const velocity = Math.min(Math.abs(scrollY - lastScrollY), 50);
      lastScrollY = scrollY;

      if (bgAthletesInner) {
        // Parallax travel as user scrolls: image shifts vertically and subtly zooms/strides
        const yOffset = -progress * 18; // -18% vertical shift
        const xOffset = (progress * 6) - 3; // subtle horizontal running trajectory
        const scale = 1.05 + (progress * 0.08); // dynamic athletic depth perspective
        bgAthletesInner.style.transform = `translate3d(${xOffset}%, ${yOffset}%, 0) scale(${scale})`;
      }

      if (bgAthletesImg) {
        // Dynamic motion blur texture: starts at 5px soft blur, increases subtly during scrolling
        const dynamicBlur = Math.min(5 + velocity * 0.15, 10);
        bgAthletesImg.style.filter = `blur(${dynamicBlur}px) saturate(1.1) contrast(1.04)`;
      }

      ticking = false;
    }

    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(updateBgAthletesOnScroll);
        ticking = true;
      }
    }, { passive: true });

    // Initial run
    updateBgAthletesOnScroll();

    // 10. Gallery Category Filter Tabs, Expand/Collapse, and Lightbox Modal
    const filterTabs = document.querySelectorAll('.gallery-tab');
    const galleryCards = Array.from(document.querySelectorAll('.gallery-card'));
    const expandBtn = document.getElementById('gallery-expand-btn');
    const expandLabel = document.getElementById('expand-btn-label');
    const expandBadge = document.getElementById('expand-btn-badge');
    const expandHint = document.getElementById('gallery-expand-hint');

    let currentCategory = 'all';
    let isGalleryExpanded = false;

    function applyGalleryVisibility() {
      let visibleCount = 0;

      galleryCards.forEach((card, idx) => {
        const cardCat = card.getAttribute('data-category');
        const matchesCat = (currentCategory === 'all' || cardCat === currentCategory);

        let shouldShow = false;
        if (matchesCat) {
          if (currentCategory === 'all') {
            shouldShow = isGalleryExpanded ? true : (idx < 8);
          } else {
            shouldShow = true;
          }
        }

        if (shouldShow) {
          card.style.display = '';
          card.style.setProperty('--item-idx', visibleCount % 8);
          card.classList.remove('is-entering');
          void card.offsetWidth;
          card.classList.add('is-entering');
          visibleCount++;
        } else {
          card.style.display = 'none';
          card.classList.remove('is-entering');
        }
      });

      // Update Expand Button UI
      if (expandBtn) {
        if (currentCategory === 'all') {
          if (isGalleryExpanded) {
            expandLabel.textContent = 'Collapse Gallery';
            expandBadge.textContent = 'Showing All 22';
            expandBtn.classList.add('is-expanded');
            expandBtn.setAttribute('aria-expanded', 'true');
            if (expandHint) expandHint.textContent = 'Currently displaying all 22 moments. Click above to collapse back to 8 highlights.';
          } else {
            expandLabel.textContent = 'Expand All 22 Moments';
            expandBadge.textContent = 'Showing 8 of 22';
            expandBtn.classList.remove('is-expanded');
            expandBtn.setAttribute('aria-expanded', 'false');
            if (expandHint) expandHint.textContent = 'Click above to expand all 22 moments or click any category tab above to explore that specific stream.';
          }
        } else {
          expandLabel.textContent = 'Return to All Moments';
          expandBadge.textContent = `Showing ${visibleCount} Moments`;
          expandBtn.classList.remove('is-expanded');
          expandBtn.setAttribute('aria-expanded', 'false');
          if (expandHint) expandHint.textContent = `Viewing ${visibleCount} filtered moments. Click above to return to all 22 moments.`;
        }
      }
    }

    function filterGallery(category) {
      currentCategory = category;

      // Update active tab states
      filterTabs.forEach(tab => {
        const isActive = tab.getAttribute('data-filter') === category;
        tab.classList.toggle('active', isActive);
        tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });

      applyGalleryVisibility();
    }

    filterTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const filter = tab.getAttribute('data-filter') || 'all';
        filterGallery(filter);
      });
    });

    if (expandBtn) {
      expandBtn.addEventListener('click', () => {
        if (currentCategory !== 'all') {
          filterGallery('all');
        } else {
          isGalleryExpanded = !isGalleryExpanded;
          applyGalleryVisibility();
          if (!isGalleryExpanded) {
            const gal = document.getElementById('gallery');
            if (gal) gal.scrollIntoView({ behavior: 'smooth' });
          }
        }
      });
    }

    // Initial setup: start in clean 8-item preview mode
    applyGalleryVisibility();

    // Gallery Lightbox Modal
    const modal = document.getElementById('lightbox-modal');
    const backdrop = document.getElementById('lightbox-backdrop');
    const closeBtn = document.getElementById('lightbox-close');
    const lbImg = document.getElementById('lightbox-img');
    const lbTitle = document.getElementById('lightbox-title');
    const lbTag = document.getElementById('lightbox-tag');
    const lbCaption = document.getElementById('lightbox-caption');
    const lbCounter = document.getElementById('lightbox-counter');
    const prevBtn = document.getElementById('lightbox-prev');
    const nextBtn = document.getElementById('lightbox-next');

    let visibleCards = [];
    let currentLbIndex = 0;

    function getCurrentlyVisibleCards() {
      return galleryCards.filter(c => c.style.display !== 'none');
    }

    function openLightbox(index) {
      visibleCards = getCurrentlyVisibleCards();
      if (visibleCards.length === 0) return;
      if (index < 0) index = visibleCards.length - 1;
      if (index >= visibleCards.length) index = 0;
      currentLbIndex = index;

      const card = visibleCards[currentLbIndex];
      if (!card) return;

      const src = card.getAttribute('data-img') || '';
      const title = card.getAttribute('data-title') || '';
      const tag = card.getAttribute('data-tag') || '';
      const caption = card.getAttribute('data-caption') || '';

      if (lbImg) {
        lbImg.src = src;
        lbImg.alt = title;
      }
      if (lbTitle) lbTitle.textContent = title;
      if (lbTag) lbTag.textContent = tag;
      if (lbCaption) lbCaption.textContent = caption;
      if (lbCounter) lbCounter.textContent = `${currentLbIndex + 1} / ${visibleCards.length}`;

      if (modal) {
        modal.classList.add('open');
        modal.setAttribute('aria-hidden', 'false');
      }
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      if (modal) {
        modal.classList.remove('open');
        modal.setAttribute('aria-hidden', 'true');
      }
      document.body.style.overflow = '';
      if (lbImg) lbImg.src = '';
    }

    galleryCards.forEach(card => {
      card.addEventListener('click', () => {
        visibleCards = getCurrentlyVisibleCards();
        const idx = visibleCards.indexOf(card);
        openLightbox(idx >= 0 ? idx : 0);
      });

      card.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          visibleCards = getCurrentlyVisibleCards();
          const idx = visibleCards.indexOf(card);
          openLightbox(idx >= 0 ? idx : 0);
        }
      });
    });

    if (closeBtn) closeBtn.addEventListener('click', closeLightbox);
    if (backdrop) backdrop.addEventListener('click', closeLightbox);
    if (prevBtn) prevBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      openLightbox(currentLbIndex - 1);
    });
    if (nextBtn) nextBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      openLightbox(currentLbIndex + 1);
    });

    window.addEventListener('keydown', (e) => {
      if (!modal || !modal.classList.contains('open')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') openLightbox(currentLbIndex - 1);
      if (e.key === 'ArrowRight') openLightbox(currentLbIndex + 1);
    });
  </script>
</body>
</html>
