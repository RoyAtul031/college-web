<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#064e3b" />
  <meta name="description" content="XAVATHON 2027 - St. Xavier's College, Kolkata. 2nd Edition Marathon themed 'Towards Greener Footprints'. 3KM, 5KM, 10KM." />
  <meta property="og:title" content="XAVATHON 2027 - St. Xavier's College, Kolkata" />
  <meta property="og:description" content="2nd Edition Annual Marathon â€” Towards Greener Footprints. Join 3K, 5K & 10K races at SXC Kolkata." />
  <meta property="og:type" content="website" />
  <title>XAVATHON 2027 - St. Xavier's College, Kolkata</title>
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Newsreader:ital,opsz,wght@1,6..72,400;1,6..72,500;1,6..72,600&family=Outfit:wght@300;400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/style.css" />
  <style>
    /* Athlenic Enhancements for About Section */
    .about-lead-container {
      margin-bottom: 2.5rem;
    }
    .about-hero-card {
      background: linear-gradient(135deg, rgba(255,255,255,0.95) 0%, rgba(246,249,247,0.95) 100%);
      border: 1px solid rgba(16, 185, 129, 0.25);
      border-radius: 16px;
      padding: 2.5rem;
      box-shadow: 0 10px 30px rgba(6, 78, 59, 0.06);
      position: relative;
      overflow: hidden;
    }
    .about-hero-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 5px;
      height: 100%;
      background: linear-gradient(180deg, #10b981 0%, #d4a359 100%);
    }
    .athlenic-badge-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 1.25rem;
    }
    .athlenic-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      background: #064e3b;
      color: #ffffff;
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 0.35rem 0.85rem;
      border-radius: 999px;
    }
    .athlenic-subbadge {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      background: rgba(212, 163, 89, 0.15);
      color: #996515;
      border: 1px solid rgba(212, 163, 89, 0.35);
      font-size: 0.75rem;
      font-weight: 700;
      padding: 0.35rem 0.85rem;
      border-radius: 999px;
    }
    .about-headline {
      font-family: var(--font-heading, 'Outfit', sans-serif);
      font-size: clamp(2rem, 3.5vw, 2.7rem);
      font-weight: 800;
      color: var(--text-dark, #0f172a);
      line-height: 1.2;
      margin-bottom: 1rem;
    }
    .about-headline em {
      font-style: italic;
      color: #059669;
      font-family: var(--font-display, 'Newsreader', serif);
    }
    .about-intro-paragraphs {
      color: #334155;
      font-size: 1.05rem;
      line-height: 1.75;
      margin-bottom: 1.75rem;
    }
    .about-intro-paragraphs p {
      margin-bottom: 0.85rem;
    }
    .athlenic-meta-chips {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 0.85rem;
      padding-top: 1.25rem;
      border-top: 1px solid rgba(16, 185, 129, 0.15);
    }
    .meta-chip-item {
      display: flex;
      align-items: flex-start;
      gap: 0.75rem;
      background: #ffffff;
      border: 1px solid rgba(0, 0, 0, 0.06);
      border-radius: 10px;
      padding: 0.85rem 1rem;
      transition: all 0.2s ease;
    }
    .meta-chip-item:hover {
      border-color: #10b981;
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(16, 185, 129, 0.08);
    }
    .meta-chip-icon {
      font-size: 1.35rem;
      line-height: 1;
      margin-top: 2px;
    }
    .meta-chip-label {
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: #64748b;
      font-weight: 700;
      display: block;
      margin-bottom: 2px;
    }
    .meta-chip-val {
      font-size: 0.92rem;
      font-weight: 700;
      color: #0f172a;
      display: block;
    }

    /* 2-Column Section for Why Xavathon & Green Initiatives */
    .about-two-pillars-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
      margin-bottom: 3.5rem;
    }
    @media (max-width: 900px) {
      .about-two-pillars-grid {
        grid-template-columns: 1fr;
      }
    }
    .pillar-card {
      background: #ffffff;
      border: 1px solid rgba(0, 0, 0, 0.08);
      border-radius: 16px;
      padding: 2.2rem;
      display: flex;
      flex-direction: column;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
      transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    }
    .pillar-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.07);
    }
    .pillar-card.why-card {
      border-top: 4px solid #0284c7;
    }
    .pillar-card.green-card {
      border-top: 4px solid #10b981;
      background: linear-gradient(180deg, #ffffff 0%, #f0fdf4 100%);
    }
    .pillar-header {
      margin-bottom: 1.25rem;
    }
    .pillar-tag {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      font-size: 0.72rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 0.3rem 0.75rem;
      border-radius: 999px;
      margin-bottom: 0.75rem;
    }
    .why-tag {
      background: rgba(2, 132, 199, 0.1);
      color: #0284c7;
    }
    .green-tag {
      background: rgba(16, 185, 129, 0.15);
      color: #047857;
    }
    .pillar-title {
      font-family: var(--font-heading, 'Outfit', sans-serif);
      font-size: 1.65rem;
      font-weight: 800;
      color: var(--text-dark, #0f172a);
      margin-bottom: 0.6rem;
    }
    .pillar-desc {
      font-size: 0.95rem;
      color: #475569;
      line-height: 1.65;
      margin-bottom: 1.5rem;
    }
    .pillar-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 0.9rem;
    }
    .pillar-list-item {
      display: flex;
      align-items: flex-start;
      gap: 0.85rem;
      padding: 0.75rem 0.9rem;
      background: #f8fafc;
      border-radius: 10px;
      border: 1px solid rgba(0, 0, 0, 0.04);
      transition: all 0.2s ease;
    }
    .green-card .pillar-list-item {
      background: rgba(255, 255, 255, 0.85);
      border-color: rgba(16, 185, 129, 0.15);
    }
    .pillar-list-item:hover {
      background: #ffffff;
      border-color: rgba(0, 0, 0, 0.12);
      transform: translateX(4px);
    }
    .pillar-item-icon {
      font-size: 1.25rem;
      line-height: 1;
      margin-top: 1px;
      flex-shrink: 0;
    }
    .pillar-item-text strong {
      display: block;
      font-size: 0.92rem;
      color: #0f172a;
      margin-bottom: 0.15rem;
    }
    .pillar-item-text span {
      font-size: 0.82rem;
      color: #64748b;
      line-height: 1.45;
      display: block;
    }

    /* Updated Race Category Cards from Athlenic */
    .athlenic-races-box {
      background: #ffffff;
      border: 1px solid rgba(0, 0, 0, 0.08);
      border-radius: 16px;
      padding: 2.5rem;
      box-shadow: 0 6px 24px rgba(0, 0, 0, 0.04);
    }
    .races-box-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      flex-wrap: wrap;
      gap: 1rem;
      margin-bottom: 2rem;
      padding-bottom: 1.25rem;
      border-bottom: 1px solid #e2e8f0;
    }
    .races-title-group h3 {
      font-family: var(--font-heading, 'Outfit', sans-serif);
      font-size: 1.8rem;
      font-weight: 800;
      color: #0f172a;
      margin-bottom: 0.25rem;
    }
    .races-title-group p {
      font-size: 0.95rem;
      color: #64748b;
      margin: 0;
    }
    .races-grid-three {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
    @media (max-width: 900px) {
      .races-grid-three {
        grid-template-columns: 1fr;
      }
    }
    .ath-race-card {
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      padding: 1.75rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      background: #ffffff;
      position: relative;
      transition: all 0.25s ease;
    }
    .ath-race-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 28px rgba(0, 0, 0, 0.08);
      border-color: #10b981;
    }
    .ath-race-card.popular {
      border: 2px solid #10b981;
      background: linear-gradient(180deg, #ffffff 0%, #f0fdf4 100%);
    }
    .popular-ribbon {
      position: absolute;
      top: -12px;
      right: 18px;
      background: #10b981;
      color: #ffffff;
      font-size: 0.68rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      padding: 0.2rem 0.75rem;
      border-radius: 999px;
      text-transform: uppercase;
      box-shadow: 0 2px 8px rgba(16, 185, 129, 0.4);
    }
    .ath-race-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1rem;
    }
    .ath-dist-pill {
      font-family: var(--font-display, 'Newsreader', serif);
      font-size: 1.4rem;
      font-weight: 800;
      color: #064e3b;
      background: rgba(16, 185, 129, 0.12);
      padding: 0.25rem 0.85rem;
      border-radius: 8px;
    }
    .ath-price {
      font-family: var(--font-heading, 'Outfit', sans-serif);
      font-size: 1.6rem;
      font-weight: 800;
      color: #0f172a;
    }
    .ath-race-name {
      font-size: 1.2rem;
      font-weight: 800;
      color: #0f172a;
      margin-bottom: 0.35rem;
    }
    .ath-age-pill {
      display: inline-block;
      font-size: 0.72rem;
      color: #64748b;
      background: #f1f5f9;
      padding: 0.15rem 0.55rem;
      border-radius: 4px;
      margin-bottom: 1rem;
      font-weight: 600;
    }
    .ath-inclusions-list {
      list-style: none;
      padding: 0;
      margin: 0 0 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 0.45rem;
    }
    .ath-inclusions-list li {
      font-size: 0.84rem;
      color: #334155;
      display: flex;
      align-items: center;
      gap: 0.45rem;
    }
    .ath-inclusions-list li svg {
      color: #10b981;
      flex-shrink: 0;
    }
    .btn-ath-reg {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.45rem;
      width: 100%;
      padding: 0.75rem 1rem;
      font-weight: 700;
      font-size: 0.9rem;
      border-radius: 8px;
      text-decoration: none;
      transition: all 0.2s ease;
      background: #064e3b;
      color: #ffffff;
      border: none;
    }
    .btn-ath-reg:hover {
      background: #047857;
      transform: translateY(-1px);
    }
    .ath-race-card.popular .btn-ath-reg {
      background: #10b981;
    }
    .ath-race-card.popular .btn-ath-reg:hover {
      background: #059669;
    }
    .athlenic-verify-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 0.8rem;
      color: #047857;
      font-weight: 600;
      background: rgba(16, 185, 129, 0.1);
      padding: 0.35rem 0.75rem;
      border-radius: 6px;
    }

    /* Charity & Financial Architecture Section Styles (Synchronized with Slate-Teal & Botanical Theme) */
    .charity-section {
      background:
        radial-gradient(ellipse 70% 50% at 20% 25%, rgba(16, 185, 129, 0.15) 0%, transparent 65%),
        radial-gradient(ellipse 60% 45% at 85% 75%, rgba(212, 163, 89, 0.10) 0%, transparent 65%),
        linear-gradient(180deg, #102a3a 0%, #0d2828 20%, #092e24 50%, #0c2b22 80%, #102521 100%);
      color: #ffffff;
      border-top: 1px solid rgba(246, 245, 239, 0.10);
      border-bottom: 1px solid rgba(24, 54, 74, 0.12);
      position: relative;
      overflow: hidden;
      padding: 5rem 0;
    }
    .charity-section::before {
      content: 'GREATER IMPACT';
      position: absolute;
      top: 6%;
      left: 2%;
      font-family: var(--font-display, sans-serif);
      font-size: 13vw;
      font-weight: 900;
      color: rgba(246, 245, 239, 0.022);
      letter-spacing: 0.08em;
      pointer-events: none;
      user-select: none;
      line-height: 1;
    }
    .charity-header-wrap {
      margin-bottom: 3.5rem;
      position: relative;
      z-index: 1;
    }
    .charity-lead {
      color: #cbd5e1;
      font-size: 1.1rem;
      max-width: 750px;
      line-height: 1.7;
    }
    .charity-two-col {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
      align-items: stretch;
      margin-bottom: 3rem;
      position: relative;
      z-index: 1;
    }
    @media (max-width: 960px) {
      .charity-two-col {
        grid-template-columns: 1fr;
      }
    }
    .charity-card {
      background: linear-gradient(165deg, rgba(16, 44, 58, 0.72) 0%, rgba(10, 42, 34, 0.78) 100%);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border: 1px solid rgba(203, 189, 173, 0.22);
      border-radius: 16px;
      padding: 2.5rem;
      display: flex;
      flex-direction: column;
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35);
      position: relative;
      transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
    }
    .charity-card:hover {
      transform: translateY(-4px);
      border-color: rgba(16, 185, 129, 0.45);
      box-shadow: 0 20px 48px rgba(0, 0, 0, 0.45);
    }
    .charity-card::after {
      content: '';
      position: absolute;
      inset: 7px;
      border: 1px solid rgba(212, 163, 89, 0.12);
      border-radius: 11px;
      pointer-events: none;
    }
    .charity-model-card {
      border-top: 3px solid #10b981;
    }
    .charity-impact-card {
      border-top: 3px solid #d4a359;
    }
    .charity-coin-badge {
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 1.5rem auto 2rem;
      width: 140px;
      height: 140px;
      border-radius: 50%;
      background: radial-gradient(circle, #f0fdf4 0%, #a7f3d0 45%, #059669 85%, #064e3b 100%);
      border: 3px solid #6ee7b7;
      box-shadow: 0 0 25px rgba(16, 185, 129, 0.35), inset 0 0 15px rgba(0, 0, 0, 0.3);
      text-align: center;
      color: #064e3b;
      flex-direction: column;
      font-family: var(--font-heading, sans-serif);
      padding: 0.5rem;
    }
    .coin-sub {
      font-size: 0.7rem;
      font-weight: 800;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #064e3b;
    }
    .coin-amt {
      font-size: 2rem;
      font-weight: 900;
