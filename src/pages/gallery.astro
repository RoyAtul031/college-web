---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#064e3b" />
  <meta name="description" content="Official Gallery & Visual Archive — XAVATHON 2026 & 2027. St. Xavier's College (Autonomous), Kolkata." />
  <title>Gallery &amp; Visual Archive — XAVATHON 2026 &amp; 2027</title>
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Newsreader:ital,opsz,wght@1,6..72,400;1,6..72,500;1,6..72,600&family=Outfit:wght@300;400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/style.css" />
  <style>
    /* Standalone Showcase Specific Polish */
    body {
      background-color: #faf7f1;
    }
    .showcase-header {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(7, 11, 18, 0.96);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-bottom: 1px solid rgba(212, 163, 89, 0.3);
      padding: 0.85rem 1.5rem;
    }
    .showcase-header-inner {
      max-width: 1200px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
    }
    .showcase-brand {
      display: flex;
      align-items: center;
      gap: 0.85rem;
      text-decoration: none;
    }
    .showcase-badge {
      background: linear-gradient(135deg, #10b981 0%, #059669 100%);
      color: #ffffff;
      font-family: var(--font-heading);
      font-size: 0.72rem;
      font-weight: 700;
      padding: 0.25rem 0.7rem;
      border-radius: 999px;
      letter-spacing: 0.06em;
    }
    .showcase-nav-btns {
      display: flex;
      align-items: center;
      gap: 0.85rem;
    }
    .btn-full-site {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      color: #e2e8f0;
      font-family: var(--font-heading);
      font-size: 0.82rem;
      font-weight: 700;
      text-decoration: none;
      padding: 0.45rem 0.95rem;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.2);
      transition: all 0.2s ease;
    }
    .btn-full-site:hover {
      background: rgba(255, 255, 255, 0.1);
      color: #ffffff;
    }
    .gallery-standalone-hero {
      padding: 3.5rem 1rem 1rem;
      text-align: center;
      background: radial-gradient(circle at 50% 20%, rgba(16, 185, 129, 0.08) 0%, transparent 70%);
    }
    .showcase-subhead {
      color: var(--muted);
      font-size: 0.95rem;
      max-width: 600px;
      margin: 0.5rem auto 0;
    }
  </style>
</head>
<body>

  <!-- Top Showcase Bar -->
  <header class="showcase-header">
    <div class="showcase-header-inner">
      <a href="/" class="showcase-brand">
        <picture>
          <source srcset="/sxc-logo.webp" type="image/webp" />
          <img src="/sxc-logo.png" alt="St. Xavier's College Crest" width="42" height="42" style="border-radius:50%;" />
        </picture>
        <div class="brand-text">
          <span class="brand-college" style="font-size: 0.75rem; letter-spacing: 0.12em; color: #d4a359;">ST. XAVIER'S COLLEGE</span>
          <span class="brand-name" style="font-size: 1.1rem; color: #ffffff;">XAVATHON <b>GALLERY SHOWCASE</b></span>
        </div>
      </a>

      <div class="showcase-nav-btns">
        <span class="showcase-badge">MODULE 10 &bull; 56 PHOTOS</span>
        <a href="/full-event" class="btn-full-site">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
          <span>Full Event Website</span>
        </a>
      </div>
    </div>
  </header>

  <main>
    <!-- SECTION 10: GALLERY — 56 CURATED MOMENTS ACROSS 7 STREAMS & INSTAGRAM INTEGRATION -->
    <section class="section gallery-section" id="gallery" style="padding-top: 2.5rem;">
      <div class="container">
        
        <div class="gallery-header-wrap">
          <div class="section-tag" style="margin-bottom: 0.75rem;">
            <span class="tag-num">10</span>
            <span class="tag-line"></span>
            <span class="tag-text">OFFICIAL GALLERY ARCHIVE</span>
          </div>

          <div class="gallery-title-group">
            <span class="gallery-pill-badge">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
              56 CURATED MOMENTS &bull; 7 VISUAL STREAMS
            </span>
            <h1 class="display-h2" style="font-size: clamp(2.2rem, 4.5vw, 3.4rem); margin: 0.4rem 0;">
              Xavathon <em>Visual Archive</em>
            </h1>
            <p class="lead-p" style="max-width: 720px;">
              An exclusive visual showcase of Xavathon 2026 and preview of Xavathon 2027. Featuring circular athletic frames, glowing category rings, real-time filtering, and fullscreen high-resolution inspection.
            </p>
          </div>
        </div>

        <!-- Category Filter Tabs -->
        <div class="gallery-filter-wrap">
          <div class="gallery-tabs-scroll" role="tablist" aria-label="Filter gallery by category">
            <button class="gallery-tab active" data-filter="all" role="tab" aria-selected="true">
              <span class="tab-label">All Moments</span>
              <span class="tab-count">56</span>
            </button>
            <button class="gallery-tab" data-filter="race-day" role="tab" aria-selected="false">
              <span class="tab-label">Xavathon 2026 — Race Day</span>
              <span class="tab-count">8</span>
            </button>
            <button class="gallery-tab" data-filter="runners" role="tab" aria-selected="false">
              <span class="tab-label">Xavathon 2026 — Runners</span>
              <span class="tab-count">8</span>
            </button>
            <button class="gallery-tab" data-filter="volunteers" role="tab" aria-selected="false">
              <span class="tab-label">Xavathon 2026 — Volunteers</span>
              <span class="tab-count">8</span>
            </button>
            <button class="gallery-tab" data-filter="bts" role="tab" aria-selected="false">
              <span class="tab-label">Xavathon 2026 — Behind the Scenes</span>
              <span class="tab-count">8</span>
            </button>
            <button class="gallery-tab" data-filter="awards" role="tab" aria-selected="false">
              <span class="tab-label">Xavathon 2026 — Awards</span>
              <span class="tab-count">8</span>
            </button>
            <button class="gallery-tab" data-filter="campus" role="tab" aria-selected="false">
              <span class="tab-label">Xavathon 2026 — Campus</span>
              <span class="tab-count">8</span>
            </button>
            <button class="gallery-tab" data-filter="coming-soon" role="tab" aria-selected="false">
              <span class="tab-label">Xavathon 2027 — Coming Soon</span>
              <span class="tab-count">8</span>
            </button>
          </div>
        </div>

        <!-- 56-Card Circular Gallery Grid with Colorful Gradient Rings -->
        <div class="gallery-cards-grid round-gallery-grid" id="gallery-cards-grid">
          {galleryItems.map((item, idx) => (
            <div 
              class={`gallery-card gallery-round-card cat-theme-${item.category}`}
              data-category={item.category}
              data-img={item.img}
              data-title={item.title}
              data-tag={item.categoryLabel}
              data-caption={item.caption}
              data-id={item.id}
              data-index={idx}
              style={`--item-idx: ${idx % 8};`}
              tabindex="0"
              role="button"
              aria-label={`View photo: ${item.title}`}
            >
              <!-- Glowing Colorful Gradient Ring -->
              <div class="gallery-round-ring">
                <div class="gallery-round-circle">
                  <img 
                    src={item.img} 
                    alt={item.title} 
                    class="gallery-round-img" 
                    loading="lazy" 
                  />
                  <!-- Circular Hover Glass Overlay -->
                  <div class="gallery-round-overlay">
                    <div class="overlay-round-zoom">
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="11" y1="8" x2="11" y2="14"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg>
                    </div>
                    <span class="overlay-round-tag">{item.categoryLabel}</span>
                  </div>
                </div>
                <!-- Mini Number Pill on Ring -->
                <span class="ring-num-badge">#{String(item.id).padStart(2, '0')}</span>
              </div>

              <!-- Descriptive Label Under Round Frame -->
              <div class="gallery-round-info">
                <h4 class="gallery-round-title">{item.title}</h4>
                <div class="gallery-round-subline">
                  <span class="gallery-round-cat-pill">{item.categoryLabel}</span>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- Dynamic Expand / Collapse Control Bar -->
        <div class="gallery-expand-bar" id="gallery-expand-bar">
          <button class="gallery-expand-btn" id="gallery-expand-btn" aria-expanded="false">
            <span class="expand-btn-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><polyline points="8 12 12 16 16 12"></polyline><line x1="12" y1="8" x2="12" y2="16"></line></svg>
            </span>
            <span class="expand-btn-label" id="expand-btn-label">Expand All 56 Moments</span>
            <span class="expand-btn-badge" id="expand-btn-badge">Showing 8 of 56</span>
          </button>
          <p class="gallery-expand-hint" id="gallery-expand-hint">
            Click above to expand all 56 moments or click any category tab above to explore that specific stream.
          </p>
        </div>

        <!-- Instagram Integration Live Banner (Bottom of Gallery before Footer) -->
        <div class="instagram-feed-banner" style="margin-top: 3rem;">
          <div class="ig-banner-left">
            <div class="ig-icon-glow">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
              </svg>
            </div>
            <div class="ig-banner-text">
              <div class="ig-handle-row">
                <span class="ig-handle">@xavathon.sxc</span>
                <span class="ig-verified" title="Official Verified Handle">✓</span>
                <span class="ig-live-pill">INSTAGRAM HUB</span>
              </div>
              <p class="ig-desc">
                Follow our official handle for live route reels, training camps, athlete interviews, and real-time updates!
              </p>
            </div>
          </div>
          <div class="ig-banner-right">
            <div class="ig-tags-pills">
              <span class="ig-tag">#Xavathon2026</span>
              <span class="ig-tag">#TowardsGreenerFootprints</span>
              <span class="ig-tag">#SXCKolkata</span>
            </div>
            <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="ig-follow-btn" aria-label="Visit Xavathon on Instagram">
              <span>View on Instagram</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M7 17l9.2-9.2M17 17V8H8"/></svg>
            </a>
          </div>
        </div>

        <!-- Fullscreen Interactive Lightbox Modal -->
        <div class="gallery-lightbox-modal" id="lightbox-modal" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Image Lightbox Preview">
          <div class="lb-backdrop" id="lightbox-backdrop"></div>
          <div class="lb-container">
            <button class="lb-close-btn" id="lightbox-close" aria-label="Close image lightbox">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            </button>
            
            <button class="lb-nav-btn lb-prev-btn" id="lightbox-prev" aria-label="Previous image">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
            </button>
            
            <div class="lb-content">
              <div class="lb-img-box">
                <img src="" alt="" id="lightbox-img" class="lb-image" />
              </div>
              <div class="lb-meta-bar">
                <div class="lb-meta-left">
                  <span class="lb-cat-badge" id="lightbox-tag"></span>
                  <h3 class="lb-title" id="lightbox-title"></h3>
                  <p class="lb-caption" id="lightbox-caption"></p>
                </div>
                <div class="lb-meta-right">
                  <span class="lb-counter" id="lightbox-counter"></span>
                </div>
              </div>
            </div>

            <button class="lb-nav-btn lb-next-btn" id="lightbox-next" aria-label="Next image">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </button>
          </div>
        </div>

      </div>
    </section>
  </main>

  <footer style="background: #0b1d2a; color: #f5f0e8; padding: 2.5rem 1.5rem; text-align: center; border-top: 1px solid rgba(212, 163, 89, 0.25);">
    <div class="container" style="max-width: 900px; margin: 0 auto;">
      <p style="margin: 0; font-family: var(--font-heading); font-size: 1rem; color: #d4a359; letter-spacing: 0.05em;">
        ST. XAVIER'S COLLEGE (AUTONOMOUS), KOLKATA
      </p>
      <p style="margin: 0.4rem 0 1rem; font-size: 0.85rem; color: #94a3b8;">
        Xavathon Visual Archive Module &bull; Dedicated Showcase Presentation
      </p>
      <a href="/full-event" style="display: inline-flex; align-items: center; gap: 0.4rem; color: #10b981; text-decoration: none; font-weight: 600; font-size: 0.85rem;">
        &larr; View Full Event Website
      </a>
    </div>
  </footer>

  <!-- Vanilla JS: Tabs, Expand/Collapse, Lightbox -->
  <script is:inline>
    // Gallery Category Filter Tabs & Expand/Collapse State
    const filterTabs = document.querySelectorAll('.gallery-tab');
    const galleryCards = Array.from(document.querySelectorAll('.gallery-card'));
    const expandBtn = document.getElementById('gallery-expand-btn');
    const expandLabel = document.getElementById('expand-btn-label');
    const expandBadge = document.getElementById('expand-btn-badge');
    const expandHint = document.getElementById('gallery-expand-hint');

    let currentCategory = 'all';
    let isGalleryExpanded = false;

    function applyGalleryVisibility() {
      let visibleCount = 0;

      galleryCards.forEach((card, idx) => {
        const cardCat = card.getAttribute('data-category');
        const matchesCat = (currentCategory === 'all' || cardCat === currentCategory);

        let shouldShow = false;
        if (matchesCat) {
          if (currentCategory === 'all') {
            shouldShow = isGalleryExpanded ? true : (idx < 8);
          } else {
            shouldShow = true;
          }
        }

        if (shouldShow) {
          card.style.display = '';
          card.style.setProperty('--item-idx', visibleCount % 8);
          card.classList.remove('is-entering');
          void card.offsetWidth;
          card.classList.add('is-entering');
          visibleCount++;
        } else {
          card.style.display = 'none';
          card.classList.remove('is-entering');
        }
      });

      // Update Expand Button UI
      if (expandBtn) {
        if (currentCategory === 'all') {
          if (isGalleryExpanded) {
            expandLabel.textContent = 'Collapse Gallery';
            expandBadge.textContent = 'Showing All 56';
            expandBtn.classList.add('is-expanded');
            expandBtn.setAttribute('aria-expanded', 'true');
            if (expandHint) expandHint.textContent = 'Currently displaying all 56 moments. Click above to collapse back to 8 highlights.';
          } else {
            expandLabel.textContent = 'Expand All 56 Moments';
            expandBadge.textContent = 'Showing 8 of 56';
            expandBtn.classList.remove('is-expanded');
            expandBtn.setAttribute('aria-expanded', 'false');
            if (expandHint) expandHint.textContent = 'Click above to expand all 56 moments or click any category tab above to explore that specific stream.';
          }
        } else {
          expandLabel.textContent = 'Return to All Moments';
          expandBadge.textContent = `Showing 8 Moments`;
          expandBtn.classList.remove('is-expanded');
          expandBtn.setAttribute('aria-expanded', 'false');
          if (expandHint) expandHint.textContent = 'Viewing 8 filtered moments. Click above to return to the full visual archive.';
        }
      }
    }

    function filterGallery(category) {
      currentCategory = category;

      // Update active tab states
      filterTabs.forEach(tab => {
        const isActive = tab.getAttribute('data-filter') === category;
        tab.classList.toggle('active', isActive);
        tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });

      applyGalleryVisibility();
    }

    filterTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const filter = tab.getAttribute('data-filter') || 'all';
        filterGallery(filter);
      });
    });

    if (expandBtn) {
      expandBtn.addEventListener('click', () => {
        if (currentCategory !== 'all') {
          filterGallery('all');
        } else {
          isGalleryExpanded = !isGalleryExpanded;
          applyGalleryVisibility();
          if (!isGalleryExpanded) {
            window.scrollTo({ top: 0, behavior: 'smooth' });
          }
        }
      });
    }

    // Initial setup: start in clean 8-item preview mode
    applyGalleryVisibility();

    // Gallery Lightbox Modal
    const modal = document.getElementById('lightbox-modal');
    const backdrop = document.getElementById('lightbox-backdrop');
    const closeBtn = document.getElementById('lightbox-close');
    const lbImg = document.getElementById('lightbox-img');
    const lbTitle = document.getElementById('lightbox-title');
    const lbTag = document.getElementById('lightbox-tag');
    const lbCaption = document.getElementById('lightbox-caption');
    const lbCounter = document.getElementById('lightbox-counter');
    const prevBtn = document.getElementById('lightbox-prev');
    const nextBtn = document.getElementById('lightbox-next');

    let visibleCards = [];
    let currentLbIndex = 0;

    function getCurrentlyVisibleCards() {
      return galleryCards.filter(c => c.style.display !== 'none');
    }

    function openLightbox(index) {
      visibleCards = getCurrentlyVisibleCards();
      if (visibleCards.length === 0) return;
      if (index < 0) index = visibleCards.length - 1;
      if (index >= visibleCards.length) index = 0;
      currentLbIndex = index;

      const card = visibleCards[currentLbIndex];
      if (!card) return;

      const src = card.getAttribute('data-img') || '';
      const title = card.getAttribute('data-title') || '';
      const tag = card.getAttribute('data-tag') || '';
      const caption = card.getAttribute('data-caption') || '';

      if (lbImg) {
        lbImg.src = src;
        lbImg.alt = title;
      }
      if (lbTitle) lbTitle.textContent = title;
      if (lbTag) lbTag.textContent = tag;
      if (lbCaption) lbCaption.textContent = caption;
      if (lbCounter) lbCounter.textContent = `${currentLbIndex + 1} / ${visibleCards.length}`;

      if (modal) {
        modal.classList.add('open');
        modal.setAttribute('aria-hidden', 'false');
      }
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      if (modal) {
        modal.classList.remove('open');
        modal.setAttribute('aria-hidden', 'true');
      }
      document.body.style.overflow = '';
      if (lbImg) lbImg.src = '';
    }

    galleryCards.forEach(card => {
      card.addEventListener('click', () => {
        visibleCards = getCurrentlyVisibleCards();
        const idx = visibleCards.indexOf(card);
        openLightbox(idx >= 0 ? idx : 0);
      });

      card.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          visibleCards = getCurrentlyVisibleCards();
          const idx = visibleCards.indexOf(card);
          openLightbox(idx >= 0 ? idx : 0);
        }
      });
    });

    if (closeBtn) closeBtn.addEventListener('click', closeLightbox);
    if (backdrop) backdrop.addEventListener('click', closeLightbox);
    if (prevBtn) prevBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      openLightbox(currentLbIndex - 1);
    });
    if (nextBtn) nextBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      openLightbox(currentLbIndex + 1);
    });

    window.addEventListener('keydown', (e) => {
      if (!modal || !modal.classList.contains('open')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') openLightbox(currentLbIndex - 1);
      if (e.key === 'ArrowRight') openLightbox(currentLbIndex + 1);
    });
  </script>
</body>
</html>
