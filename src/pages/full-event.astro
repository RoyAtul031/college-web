    <!-- SECTION 1: ABOUT XAVATHON -->
    <section class="section about-section" id="about">
      <div class="container">
        <div class="section-tag">
          <span class="tag-num">01</span>
          <span class="tag-line"></span>
          <span class="tag-text">ABOUT THE MARATHON</span>
        </div>

        <div class="about-grid">
          <div class="about-text-col">
            <h2 class="display-h2">Where Health, Energy &amp; <em>Impact Converge.</em></h2>
            <p class="lead-p">
              <strong>XAVATHON</strong> is the flagship annual marathon hosted by <strong>St. Xavier's College (Autonomous), Kolkata</strong>. Returning for its celebrated <strong>2nd Edition</strong> with the theme <strong>"Towards Greener Footprints"</strong>, Xavathon rallies students, alumni, professors, and Kolkata's vibrant running fraternity behind a shared ecological mission.
            </p>
            <p class="body-p">
              Far more than an athletic competition, Xavathon champions environmental conservation, active living, and sustainable community stewardship. Every stride run directly supports green campus drives, tree sapling distribution, and zero-plastic waste reduction in our city.
            </p>

            <div class="stats-ribbon">
              <div class="stat-card">
                <span class="stat-value">3,000+</span>
                <span class="stat-desc">Expected Runners</span>
              </div>
              <div class="stat-card">
                <span class="stat-value">3</span>
                <span class="stat-desc">Race Distances</span>
              </div>
              <div class="stat-card">
                <span class="stat-value">2nd</span>
                <span class="stat-desc">Grand Edition</span>
              </div>
              <div class="stat-card">
                <span class="stat-value">1860</span>
                <span class="stat-desc">SXC Heritage Year</span>
              </div>
            </div>

            <div class="why-run-card">
              <h4>Why Run With Us?</h4>
              <ul class="why-run-list">
                <li><span class="check-mark">✓</span> Professional chip timing &amp; verified splits</li>
                <li><span class="check-mark">✓</span> Official finisher medal &amp; digital certificate</li>
                <li><span class="check-mark">✓</span> Eco-friendly race kit &amp; breathable jersey</li>
                <li><span class="check-mark">✓</span> Hydration stations at every kilometre</li>
                <li><span class="check-mark">✓</span> Full medical support &amp; emergency response</li>
                <li><span class="check-mark">✓</span> Post-race hot refreshments &amp; breakfast</li>
              </ul>
            </div>
          </div>

          <!-- Race Categories Cards -->
          <div class="races-col" id="races">
            <div class="race-header">
              <h3>Race Categories</h3>
              <p>Tailored courses for everyone from first-timers to competitive marathoners.</p>
            </div>

            <div class="race-cards-stack">
              <article class="race-card race-card-3k">
                <div class="race-badge">03 KM</div>
                <div class="race-content">
                  <h4>Fun Run &bull; Open To All</h4>
                  <p>A spirited, family-friendly dash designed for beginners, students, and walking enthusiasts. Celebrate health and camaraderie!</p>
                  <ul class="race-perks">
                    <li>Finisher Medal &amp; E-Certificate</li>
                    <li>Official Xavathon Runner T-Shirt</li>
                    <li>Post-Race Hydration &amp; Breakfast</li>
                  </ul>
                </div>
              </article>

              <article class="race-card race-card-5k featured-race">
                <div class="featured-ribbon">POPULAR</div>
                <div class="race-badge">05 KM</div>
                <div class="race-content">
                  <h4>Challenge Run &bull; Timed</h4>
                  <p>Test your endurance through Kolkata's iconic thoroughfares. Perfect for fitness enthusiasts aiming for a personal milestone.</p>
                  <ul class="race-perks">
                    <li>RFID Timing Chip with Live Splits</li>
                    <li>Official Dry-Fit Athletic Jersey</li>
                    <li>Finisher Medal &amp; Goodie Hamper</li>
                  </ul>
                </div>
              </article>

              <article class="race-card race-card-10k">
                <div class="race-badge">10 KM</div>
                <div class="race-content">
                  <h4>Competitive Run &bull; Championship</h4>
                  <p>The premier endurance test. For competitive athletes chasing personal records and podium cash prizes.</p>
                  <ul class="race-perks">
                    <li>Official Timing &amp; Ranking Certificate</li>
                    <li>Podium Trophies &amp; Category Awards</li>
                    <li>Full Marathon Kit &amp; Recovery Zone</li>
                  </ul>
                </div>
              </article>
            </div>
          </div>
        </div>

      </div>
